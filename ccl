#!/usr/bin/env bash
# Launch Claude Code against the local Ollama endpoint, from Git Bash,
# in whatever directory you are standing in.
#
#   ccl                 interactive, in the current directory
#   ccl -p "..."        one-shot
#
# The current directory matters: Claude Code reads ./CLAUDE.md and ./.claude
# from it. start.bat exists for double-clicking; this is the one to use when
# you want a project loaded.
set -euo pipefail

CCL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

OLLAMA_URL="${CCL_OLLAMA_URL:-http://localhost:11434}"
PROXY_PORT="${CCL_PROXY_PORT:-11435}"
PROXY_URL="http://localhost:${PROXY_PORT}"
MODEL="${CCL_MODEL:-hf.co/unsloth/Qwen3-Coder-Next-GGUF:UD-IQ2_M}"
CONTEXT="${CCL_CONTEXT:-131072}"
FIT_TARGET="${CCL_FIT_TARGET:-384}"

up() { curl -s -m 3 "$1/api/version" >/dev/null 2>&1; }

wait_for() {  # url, label, tries
    local i=0
    until up "$1"; do
        i=$((i + 1))
        if [ "$i" -ge "$3" ]; then
            echo "[ccl] ERROR: $2 did not come up" >&2
            return 1
        fi
        sleep 1
    done
}

check_fit() {
    # LLAMA_ARG_FIT_TARGET is read when the server starts, so a server we did
    # not start may not have it. Rather than warn vaguely, load the model and
    # look at what actually happened. Set CCL_NO_CHECK=1 to skip.
    [ "${CCL_NO_CHECK:-}" = "1" ] && return 0
    echo "[ccl] checking fit (loading $MODEL)..."
    printf '{"model":"%s","stream":false,"options":{"num_predict":1},"messages":[{"role":"user","content":"hi"}]}' \
        "$MODEL" > "$TMPREQ"
    curl -s -m 900 -X POST "$OLLAMA_URL/api/chat" \
        -H "content-type: application/json" --data-binary "@$TMPREQ" -o /dev/null || true
    curl -s -m 30 "$OLLAMA_URL/api/ps" | python -c '
import json, sys
d = json.load(sys.stdin)
m = (d.get("models") or [{}])[0]
size, vram = m.get("size", 0), m.get("size_vram", 0)
if not size:
    print("[ccl] could not read /api/ps; skipping fit check")
    sys.exit()
pct = 100.0 * vram / size
if pct >= 99.9:
    print("[ccl] fit OK: 100%% GPU at num_ctx %s" % m.get("context_length"))
else:
    print("[ccl] WARNING: only %.0f%% on GPU -- the rest spills to CPU (~30%% slower)." % pct)
    print("[ccl] the running server was probably started without LLAMA_ARG_FIT_TARGET.")
    print("[ccl] fix: taskkill //F //IM llama-server.exe && taskkill //F //IM ollama.exe && ccl")
'
}

if up "$OLLAMA_URL"; then
    echo "[ccl] ollama already running (not restarted by ccl)"
    TMPREQ="$(mktemp)"
    trap 'rm -f "$TMPREQ"' EXIT
    check_fit
else
    echo "[ccl] starting ollama (LLAMA_ARG_FIT_TARGET=$FIT_TARGET)"
    ( LLAMA_ARG_FIT_TARGET="$FIT_TARGET" nohup ollama serve >/dev/null 2>&1 & )
    wait_for "$OLLAMA_URL" ollama 30
fi

if up "$PROXY_URL"; then
    :
else
    echo "[ccl] starting normalize_proxy on $PROXY_PORT"
    ( nohup python "$CCL_DIR/normalize_proxy.py" "$PROXY_PORT" "$OLLAMA_URL" \
        >/dev/null 2>&1 & )
    wait_for "$PROXY_URL" normalize_proxy 15
fi

export ANTHROPIC_BASE_URL="$PROXY_URL"
export ANTHROPIC_AUTH_TOKEN=ollama
export ANTHROPIC_API_KEY=
export ANTHROPIC_MODEL="$MODEL"
export ANTHROPIC_SMALL_FAST_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$MODEL"
# Claude Code does not know this model and would assume a 200k window.
export CLAUDE_CODE_MAX_CONTEXT_TOKENS="$CONTEXT"

echo "[ccl] model = $MODEL"
echo "[ccl] cwd   = $(pwd)"
exec claude "$@"
